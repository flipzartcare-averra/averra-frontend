# Your Node backend's public URL (see backend-node). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000

# From AdSense → Account → Account information, e.g. ca-pub-1234567890123456
# Leave unset to disable AdSense entirely (nothing renders, no script loads).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# WhatsApp number in international format, digits only, no + or spaces
# (e.g. 919876543210 for +91 98765 43210). Leave unset to hide the
# floating WhatsApp button and the WhatsApp option on /support entirely.
NEXT_PUBLIC_WHATSAPP_NUMBER=
